# HealWithIndia - Environment Variables Template
# Copy this file to .env.local for local development

# Local Session Secret (Required for local builds & resilient sessions)
ADMIN_SESSION_SECRET=hwi-local-resilient-session-secret-key-2026-super-secure

# Default Admin Credentials (for local resilient demo login)
DEFAULT_ADMIN_EMAIL=admin@healwithindia.com
DEFAULT_ADMIN_PASSWORD=admin123

# Optional: Remote Supabase Configuration (Leave blank/commented to use local resilient offline fallback)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
